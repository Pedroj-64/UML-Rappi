%% ============================================================
%% RAPPI - DOMINIO 07: SOPORTE, RESEÑAS, INCIDENTES Y
%% NOTIFICACIONES
%% Postventa: tickets, chat en vivo, calificaciones,
%% incidentes operativos y motores de notificación.
%% ============================================================
classDiagram
    direction TB

    class SupportTicket {
        +UUID id
        +UUID orderId
        +UUID userId
        +String categoria
        +String descripcion
        +TicketStatus estado
        +TicketPriority prioridad
        +UUID asignadoA
        +DateTime slaVencimiento
        +DateTime creadoEn
        +DateTime cerradoEn
        +String solucion
        +escalar(nivel) void
        +resolver(solucion) void
        +reabrir(motivo) void
        +asignar(agente) void
        +slaVencido() Boolean
    }

    class ChatMessage {
        +UUID id
        +UUID ticketId
        +UUID autorId
        +AuthorType autorTipo
        +String contenido
        +String[] adjuntos
        +DateTime enviadoEn
        +Boolean leido
        +marcarLeido() void
        +esDeSoporte() Boolean
    }

    class Review {
        +UUID id
        +UUID orderId
        +UUID customerId
        +UUID storeId
        +UUID courierId
        +Int puntaje
        +Int puntajeComida
        +Int puntajeEntrega
        +String comentario
        +Boolean visible
        +DateTime creadoEn
        +reportar(motivo) void
        +moderar(decision) void
        +esPositiva() Boolean
    }

    class Incident {
        +UUID id
        +UUID orderId
        +UUID deliveryId
        +String tipo
        +IncidentSeverity severidad
        +String descripcion
        +Boolean resuelto
        +UUID responsableId
        +DateTime reportadoEn
        +DateTime resueltoEn
        +registrar() void
        +notificar() void
        +resolver(accion) void
        +requiereReembolso() Boolean
    }

    class Notification {
        +UUID id
        +UUID userId
        +NotificationChannel canal
        +String titulo
        +String cuerpo
        +String deepLink
        +Boolean leida
        +DateTime enviadaEn
        +DateTime leidaEn
        +enviar() Boolean
        +marcarLeida() void
        +reintentar() void
    }

    class AuditLog {
        +UUID id
        +UUID actorId
        +String accion
        +String entidad
        +UUID entidadId
        +String metadataJson
        +String ipOrigen
        +DateTime timestamp
        +registrar() void
        +buscarPorEntidad(entidad, id) AuditLog[]
    }

    class TicketStatus {
        <<enumeration>>
        ABIERTO
        EN_PROCESO
        ESPERANDO_USUARIO
        ESCALADO
        RESUELTO
        CERRADO
    }

    class TicketPriority {
        <<enumeration>>
        BAJA
        MEDIA
        ALTA
        CRITICA
    }

    class IncidentSeverity {
        <<enumeration>>
        LEVE
        MODERADO
        GRAVE
        CRITICO
    }

    class NotificationChannel {
        <<enumeration>>
        PUSH
        SMS
        EMAIL
        WHATSAPP
        IN_APP
    }

    class AuthorType {
        <<enumeration>>
        USUARIO
        AGENTE
        BOT
        REPARTIDOR
        COMERCIO
    }

    %% ---- Clases externas referenciadas ----
    class User
    class Order
    class Customer
    class Courier
    class Store

    %% ================== RELACIONES ==================
    SupportTicket "1" --> "1" TicketStatus : tiene
    SupportTicket "1" --> "1" TicketPriority : tiene
    SupportTicket "1" *-- "0..*" ChatMessage : contiene
    ChatMessage "1" --> "1" AuthorType : escrito por

    Order "1" --> "0..*" SupportTicket : genera
    Order "1" --> "0..*" Review : evaluado en
    Order "1" --> "0..*" Incident : reporta

    User "1" --> "0..*" SupportTicket : abre
    User "1" --> "0..*" Notification : recibe
    User "1" --> "0..*" AuditLog : ejecuta acciones

    Review "0..*" --> "1" Store : califica
    Review "0..*" --> "1" Courier : califica
    Notification "1" --> "1" NotificationChannel : se envía por
    Incident "1" --> "1" IncidentSeverity : tiene
