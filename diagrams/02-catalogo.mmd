%% ============================================================
%% URBANEATS - DOMINIO 02: CATALOGOS FISICOS Y PIZARRA DE MENUS
%% Proceso 1. El administrador de archivo recopila folletos,
%% listas a mano, fotos impresas y confirmaciones verbales, y
%% con ellas transcribe, tacha o actualiza el catálogo maestro
%% (libro/carpeta) y la pizarra del centro de operaciones.
%% ============================================================
classDiagram
    direction TB

    class RestauranteAliado {
        +Int numeroAliado
        +String nombre
        +String tipoCocina
        +String direccion
        +String telefono
        +Time horaApertura
        +Time horaCierre
        +Decimal porcentajeComision
        +Date fechaAlianza
        +Boolean activo
        +estaAbierto(hora) Boolean
        +entregarMenu() FuenteMenu
    }

    class FuenteMenu {
        <<abstract>>
        +Date fechaRecepcion
        +String entregadaPor
        +Boolean transcrita
        +marcarTranscrita() void
    }

    class FolletoImpreso {
        +Int paginas
        +Date vigenteHasta
    }

    class ListaManuscrita {
        +String escritaPor
        +Boolean legible
    }

    class FotografiaImpresa {
        +String descripcion
    }

    class ConfirmacionVerbal {
        +MedioConfirmacion medio
        +Time hora
        +String confirmadoPor
        +String detalle
    }

    class CatalogoMaestro {
        +String formato
        +Int edicion
        +Date ultimaRevision
        +String ubicacionFisica
        +buscarRestaurante(nombre) FichaRestaurante
        +agregarFicha(ficha) void
        +retirarFicha(restaurante) void
        +platosDisponibles(restaurante) Plato
    }

    class FichaRestaurante {
        +Int numeroHoja
        +Date actualizadaEl
        +String notasMargen
        +leerEnVozAlta() String
    }

    class CategoriaMenu {
        +String nombre
        +Int orden
    }

    class Plato {
        +String nombre
        +String descripcion
        +Decimal precio
        +Int minutosPreparacion
        +Boolean disponible
        +Boolean tachado
        +tachar() void
        +actualizarPrecio(nuevoPrecio) void
        +marcarAgotado() void
        +reponer() void
    }

    class AnotacionCatalogo {
        +Date fecha
        +TipoCambio tipo
        +String valorAnterior
        +String valorNuevo
        +String rubrica
        +aplicar() void
    }

    class PizarraMenus {
        +String ubicacion
        +Date fechaDelDia
        +escribir(entrada) void
        +borrar(entrada) void
        +borrarTodo() void
    }

    class EntradaPizarra {
        +String texto
        +TipoEntradaPizarra tipo
        +Time escritaA
    }

    class MedioConfirmacion {
        <<enumeration>>
        PRESENCIAL
        TELEFONICA
    }

    class TipoCambio {
        <<enumeration>>
        ALTA_PLATO
        BAJA_PLATO
        CAMBIO_PRECIO
        AGOTADO
        REPUESTO
        NUEVA_CATEGORIA
    }

    class TipoEntradaPizarra {
        <<enumeration>>
        PLATO_DEL_DIA
        AGOTADO
        CAMBIO_PRECIO
        AVISO
    }

    %% ---- Clases externas referenciadas (definidas en otros diagramas) ----
    class AdministradorArchivo
    class ContactoRestaurante
    class OperadorTelefonico
    class PromotorCampo

    %% ================== RELACIONES ==================
    FuenteMenu <|-- FolletoImpreso
    FuenteMenu <|-- ListaManuscrita
    FuenteMenu <|-- FotografiaImpresa
    FuenteMenu <|-- ConfirmacionVerbal

    RestauranteAliado "1" --> "0..*" FuenteMenu : entrega
    ContactoRestaurante "1" --> "0..*" ConfirmacionVerbal : da
    AdministradorArchivo "1" --> "0..*" FuenteMenu : recopila

    CatalogoMaestro "1" *-- "0..*" FichaRestaurante : organiza
    FichaRestaurante "0..1" --> "1" RestauranteAliado : describe a
    FichaRestaurante "1" *-- "1..*" CategoriaMenu : agrupa
    CategoriaMenu "1" *-- "0..*" Plato : incluye

    AdministradorArchivo "1" --> "0..*" AnotacionCatalogo : registra
    FichaRestaurante "1" *-- "0..*" AnotacionCatalogo : historial
    AnotacionCatalogo "0..*" --> "1" FuenteMenu : se basa en
    AnotacionCatalogo "0..*" --> "0..1" Plato : afecta a

    AdministradorArchivo "1..*" --> "1" PizarraMenus : actualiza
    PizarraMenus "1" *-- "0..*" EntradaPizarra : muestra
    EntradaPizarra "0..*" --> "0..1" Plato : se refiere a

    OperadorTelefonico ..> CatalogoMaestro : consulta
    OperadorTelefonico ..> PizarraMenus : consulta
    PromotorCampo ..> CatalogoMaestro : consulta

    ConfirmacionVerbal "0..*" --> "1" MedioConfirmacion : por
    AnotacionCatalogo "0..*" --> "1" TipoCambio : es de tipo
    EntradaPizarra "0..*" --> "1" TipoEntradaPizarra : es de tipo
