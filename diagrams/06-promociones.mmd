%% ============================================================
%% RAPPI - DOMINIO 06: PROMOCIONES, SUSCRIPCIONES Y LEALTAD
%% Descuentos, cupones, campañas de marketing, Rappi Prime
%% (suscripción) y el programa de puntos.
%% ============================================================
classDiagram
    direction TB

    class Promotion {
        <<abstract>>
        +UUID id
        +String nombre
        +String descripcion
        +PromotionType tipo
        +Decimal porcentaje
        +Decimal montoFijo
        +Decimal montoMinimoCompra
        +DateTime vigenciaDesde
        +DateTime vigenciaHasta
        +Boolean acumulable
        +Boolean activa
        +Decimal presupuesto
        +Decimal gastado
        +esAplicable(Order) Boolean
        +calcularDescuento(Order) Decimal
        +activar() void
        +desactivar() void
        +presupuestoDisponible() Decimal
    }

    class Coupon {
        +UUID id
        +String codigo
        +Int usosMaximos
        +Int usosActuales
        +UUID usuarioRestringido
        +DateTime expiraEn
        +Boolean unicoPorUsuario
        +canjear(userId) Boolean
        +esValido(userId) Boolean
        +usosRestantes() Int
    }

    class Campaign {
        +UUID id
        +String nombre
        +String canal
        +String segmento
        +Decimal presupuesto
        +DateTime inicio
        +DateTime fin
        +Int impresiones
        +Int conversiones
        +Decimal cpa
        +activar() void
        +pausar() void
        +medirROI() Decimal
        +generarAudiencia() Segment
    }

    class Subscription {
        +UUID id
        +UUID userId
        +UUID planId
        +SubscriptionStatus estado
        +Boolean renovacionAutomatica
        +DateTime inicio
        +DateTime fin
        +DateTime proximoCobro
        +renovar() Boolean
        +cancelar(motivo) void
        +pausar() void
        +beneficiosActivos() Benefit[]
        +aplicarBeneficio(Order) void
    }

    class Plan {
        +UUID id
        +String nombre
        +Decimal precioMensual
        +Decimal precioAnual
        +Boolean envioGratis
        +Decimal envioGratisDesde
        +Int porcentajeDescuento
        +Benefit[] beneficios
        +precioConImpuestos(ciclo) Decimal
        +compararCon(plan) Diff
    }

    class LoyaltyAccount {
        +UUID id
        +UUID userId
        +Int puntos
        +String nivel
        +Int puntosHistoricos
        +DateTime ultimaActividad
        +acumular(puntos) void
        +canjear(puntos) Boolean
        +calcularNivel() String
        +puntosExpiran() DateTime
    }

    class Benefit {
        +UUID id
        +String nombre
        +String descripcion
        +Decimal valor
    }

    class PromotionType {
        <<enumeration>>
        PORCENTAJE
        MONTO_FIJO
        ENVIO_GRATIS
        DOS_POR_UNO
        PRIMERA_COMPRA
    }

    class SubscriptionStatus {
        <<enumeration>>
        ACTIVA
        PAUSADA
        VENCIDA
        CANCELADA
        EN_PRUEBA
    }

    %% ---- Clases externas referenciadas ----
    class User
    class Customer
    class Order
    class Store
    class Payout

    %% ================== RELACIONES ==================
    Promotion <|-- Coupon
    Coupon "0..*" --> "1" User : restringido a
    Promotion "1" --> "1" PromotionType : es de tipo

    Customer "0..1" --> "0..1" Subscription : contrata
    Subscription "0..*" --> "1" Plan : se basa en
    Plan "1" *-- "0..*" Benefit : incluye
    Subscription "1" --> "1" SubscriptionStatus : tiene

    Customer "1" --> "1" LoyaltyAccount : acumula
    Customer "1" --> "0..*" Coupon : posee

    Campaign "0..*" --> "0..*" Promotion : difunde
    Campaign "0..*" --> "1" Store : promociona
    Order "0..*" --> "0..1" Promotion : aplica
