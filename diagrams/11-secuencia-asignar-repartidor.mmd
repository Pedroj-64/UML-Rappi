%% ============================================================
%% RAPPI - SECUENCIA: ASIGNAR REPARTIDOR
%% Motor de matching, oferta al rappitendero, reintentos y
%% cálculo de tarifa por zona. Corresponde a DeliveryAssignment
%% y al estado compuesto BUSCANDO_REPARTIDOR.
%% ============================================================
sequenceDiagram
    autonumber

    participant Ord as Order
    participant Del as Servicio de Logística
    participant Zone as Zonas y Tarifas
    participant Match as Motor de Matching
    participant Coup as App Rappitendero
    participant Rep as Repartidor

    Ord->>Del: Order CONFIRMADO
    Del->>Del: Delivery.asignarCourier()
    Del->>Zone: consulta zona del punto de recogida
    Zone-->>Del: tarifaBase y multiplicadorDemanda
    Del->>Match: buscar candidatos(ubicacion, radio)
    Match-->>Del: repartidores ordenados por cercanía

    loop hasta que alguien acepte, máximo 3 rondas
        Del->>Match: pide el siguiente candidato
        Match->>Coup: oferta de entrega con comisión
        Coup->>Rep: notificación push
        Rep->>Coup: acepta o rechaza la oferta
        alt el repartidor acepta
            Coup-->>Del: ACEPTADA
            Del->>Del: DeliveryAssignment.aceptar()
        else rechaza o expira el tiempo
            Coup-->>Del: RECHAZADA o EXPIRADA
            Del->>Match: reintentar con otro candidato
        end
    end

    alt hay repartidor asignado
        Del->>Del: Delivery.estado = ASIGNADA
        Del->>Ord: asigna courierId
        Del->>Rep: instrucciones y ruta sugerida
        Note over Rep: Route.optimizar()
        Del->>Del: calcula ETA y lo comparte
    else no quedan candidatos
        Del->>Del: Delivery.estado = CANCELADA
        Del->>Ord: cancela por falta de repartidor
        Note over Ord: dispara el reembolso
    end
