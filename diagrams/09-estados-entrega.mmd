%% ============================================================
%% RAPPI - DIAGRAMA DE ESTADOS: CICLO DE VIDA DE LA ENTREGA
%% Refleja el enum DeliveryStatus de diagrams/04-logistica.mmd.
%% La búsqueda de repartidor es un estado compuesto que modela
%% el enum AssignmentState (oferta, rechazo, expiración).
%% ============================================================
stateDiagram-v2
    direction TB

    [*] --> PENDIENTE : Order confirmado

    PENDIENTE --> BUSCANDO_REPARTIDOR : Delivery.asignarCourier()

    state BUSCANDO_REPARTIDOR {
        [*] --> OFRECIDA : DeliveryAssignment.propuestaEn
        OFRECIDA --> ACEPTADA : Courier.aceptarEntrega()
        OFRECIDA --> RECHAZADA : Courier.rechazarEntrega()
        OFRECIDA --> EXPIRADA : expiraEn alcanzado
        RECHAZADA --> OFRECIDA : siguiente candidato
        EXPIRADA --> OFRECIDA : reintentar()
    }

    BUSCANDO_REPARTIDOR --> ASIGNADA : asignación ACEPTADA

    ASIGNADA --> RECOGIENDO : Courier llega a la tienda
    ASIGNADA --> CANCELADA : pedido cancelado

    RECOGIENDO --> EN_CAMINO : pedido recogido
    EN_CAMINO --> ENTREGADA : prueba de entrega válida
    EN_CAMINO --> FALLIDA : cliente no disponible

    FALLIDA --> BUSCANDO_REPARTIDOR : reintentar() con intentos < 3
    FALLIDA --> CANCELADA : intentos agotados

    ENTREGADA --> [*]
    CANCELADA --> [*]
