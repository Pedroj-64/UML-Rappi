%% ============================================================
%% URBANEATS - DIAGRAMA DE CLASES: VISTA GENERAL (MACRO)
%% Modelo de negocio 100% manual: catálogo en papel, pedidos por
%% teléfono, despacho con mapa impreso y cobro en efectivo.
%% Muestra las clases núcleo de los 4 procesos y cómo se enlazan.
%% El detalle de atributos y métodos vive en los diagramas 01..06.
%% ============================================================
classDiagram
    direction LR

    %% ---------- PERSONAS ----------
    class Persona {
        <<abstract>>
        +String nombreCompleto
        +String telefono
    }

    class Cliente {
        +Int numeroCliente
        +dictarPedido()
        +pagarEnEfectivo(monto)
        +firmarRecibo(recibo)
    }

    class Empleado {
        <<abstract>>
        +String codigoEmpleado
        +Turno turno
    }

    class AdministradorArchivo {
        +actualizarCatalogo(cambio)
    }

    class OperadorTelefonico {
        +leerMenu(ficha)
        +tomarPedido(contacto) Comanda
    }

    class Coordinador {
        +avisarCocina(comanda) AvisoCocina
        +asignarRepartidor(envio, repartidor)
    }

    class Repartidor {
        +MedioTransporte transporte
        +entregarPedido()
        +rendirCuentas() Liquidacion
    }

    class Cajero {
        +calcularComisiones(liquidacion)
        +separarEnSobres()
    }

    class AgenteCalidad {
        +llamarCliente(cliente)
        +llenarEncuesta() EncuestaSatisfaccion
    }

    class Direccion {
        +String calle
        +String barrio
        +String referencias
    }

    %% ---------- PROCESO 1: CATALOGO FISICO ----------
    class RestauranteAliado {
        +String nombre
        +String telefono
        +Decimal porcentajeComision
    }

    class CatalogoMaestro {
        +Int edicion
        +String ubicacionFisica
        +buscarRestaurante(nombre)
    }

    class Plato {
        +String nombre
        +Decimal precio
        +Boolean disponible
        +tachar()
    }

    class PizarraMenus {
        +Date fechaDelDia
        +escribir(entrada)
    }

    %% ---------- PROCESO 2: TOMA DE PEDIDOS ----------
    class Comanda {
        +Int numeroOrden
        +Time horaRecepcion
        +Decimal total
        +Boolean requiereCambio
        +EstadoComanda estado
    }

    class LineaComanda {
        +Int cantidad
        +Decimal precioUnitario
        +String notaAlMargen
    }

    %% ---------- PROCESO 3: DESPACHO ----------
    class AvisoCocina {
        +MedioAviso medio
        +Int minutosPreparacion
    }

    class Envio {
        +Int numeroEnvio
        +EstadoEnvio estado
    }

    class MapaRuta {
        +String trazadoBoligrafo
    }

    class ReciboEntrega {
        +String nombreQuienRecibe
        +Boolean firmado
    }

    %% ---------- PROCESO 4: CAJA Y CALIDAD ----------
    class Liquidacion {
        +Decimal montoEntregado
        +Decimal diferencia
    }

    class LibroCaja {
        +Int folioActual
        +anotar(asiento)
    }

    class Sobre {
        +TipoSobre tipo
        +Decimal monto
    }

    class EncuestaSatisfaccion {
        +Int calificacionGeneral
        +String comentarios
    }

    %% ================== RELACIONES ==================
    Persona <|-- Cliente
    Persona <|-- Empleado
    Empleado <|-- AdministradorArchivo
    Empleado <|-- OperadorTelefonico
    Empleado <|-- Coordinador
    Empleado <|-- Repartidor
    Empleado <|-- Cajero
    Empleado <|-- AgenteCalidad

    Cliente "1" --> "1..*" Direccion : recibe en

    AdministradorArchivo "1" --> "1" CatalogoMaestro : mantiene
    AdministradorArchivo "1" --> "1" PizarraMenus : actualiza
    CatalogoMaestro "1" o-- "0..*" RestauranteAliado : describe a
    RestauranteAliado "1" *-- "1..*" Plato : ofrece
    PizarraMenus "0..*" --> "0..*" Plato : destaca

    OperadorTelefonico ..> CatalogoMaestro : lee en voz alta
    OperadorTelefonico "1" --> "0..*" Comanda : escribe
    Cliente "1" --> "0..*" Comanda : solicita
    Comanda "1" *-- "1..*" LineaComanda : contiene
    LineaComanda "0..*" --> "1" Plato : corresponde a
    Comanda "0..*" --> "1" RestauranteAliado : se pide a
    Comanda "0..*" --> "1" Direccion : se entrega en

    Coordinador "1" --> "0..*" AvisoCocina : realiza
    AvisoCocina "0..*" --> "1" Comanda : comunica
    Coordinador "1" --> "0..*" Envio : asigna
    Comanda "1" --> "0..1" Envio : se despacha en
    Envio "0..*" --> "1" Repartidor : realizado por
    Envio "1" *-- "1" MapaRuta : lleva
    Envio "1" --> "0..1" ReciboEntrega : se acredita con

    Repartidor "1" --> "0..*" Liquidacion : rinde
    Cajero "1" --> "0..*" Liquidacion : recibe
    Liquidacion "0..1" --> "1" Envio : cierra
    Liquidacion "1" --> "1" ReciboEntrega : verifica
    Liquidacion "0..*" --> "1" LibroCaja : se anota en
    Liquidacion "0..*" --> "1..3" Sobre : reparte en

    AgenteCalidad "1" --> "0..*" EncuestaSatisfaccion : llena
    EncuestaSatisfaccion "0..*" --> "1" Comanda : evalua
