%% ============================================================
%% RAPPI - SECUENCIA: PROCESAR PAGO
%% Autorización según el medio de pago, registro contable y
%% reembolso posterior. Cubre Payment, PaymentMethod, Wallet
%% y Refund del dominio de pagos.
%% ============================================================
sequenceDiagram
    autonumber

    participant API as API de Pedidos
    participant Pay as Motor de Pagos
    participant PM as PaymentMethod
    participant Wallet as RappiPay
    participant GW as Pasarela o Banco
    participant Ledger as Libro Mayor
    participant Ord as Order

    API->>Pay: Payment.autorizar(order, monto, metodo)
    Pay->>PM: validar y tokenizar el medio de pago

    alt el medio es RappiPay
        PM->>Wallet: saldoDisponible()
        alt saldo suficiente
            Wallet->>Ledger: registra Transaccion PAGO
            Ledger-->>Wallet: saldoResultante
            Wallet-->>Pay: AUTORIZADO
        else saldo insuficiente
            Wallet-->>Pay: RECHAZADO
        end
    else tarjeta, PSE o efectivo
        PM->>GW: solicita autorización
        GW-->>PM: código de autorización
        PM-->>Pay: AUTORIZADO
    end

    alt pago autorizado
        Pay->>Pay: Payment.estado = CAPTURADO
        Pay->>Ledger: registra cobro y comisiones
        Pay-->>API: pago confirmado
        API->>Ord: habilita la preparación
    else pago rechazado
        Pay->>Pay: Payment.estado = RECHAZADO
        Pay-->>API: pago rechazado
        API->>Ord: Order.cancelar()
    end

    opt cancelación posterior del pedido
        API->>Pay: Payment.reembolsar(monto)
        Pay->>GW: solicita el reverso del cobro
        GW-->>Pay: reverso confirmado
        Pay->>Ledger: registra Transaccion REEMBOLSO
        Pay->>Pay: Refund.estado = PROCESADO
        Pay-->>API: reembolso procesado
    end
