%% ============================================================
%% URBANEATS - DOMINIO 03: TOMA Y REGISTRO MANUAL DE PEDIDOS
%% Proceso 2. El cliente llama al teléfono fijo o se acerca a un
%% punto de contacto. El operador lee el menú, escribe la comanda
%% a mano, le pone número de talonario y sello de hora, confirma
%% el pago en efectivo y la entrega en mano a la mesa de logística.
%% ============================================================
classDiagram
    direction TB

    class ContactoCliente {
        +Int numero
        +CanalContacto canal
        +Date fecha
        +Time horaInicio
        +Time horaFin
        +Boolean terminoEnPedido
        +registrarConsulta(nota) void
    }

    class Comanda {
        +Int numeroOrden
        +Date fecha
        +Time horaRecepcion
        +Boolean sellada
        +String telefonoContacto
        +String indicacionesEspeciales
        +Decimal subtotal
        +Decimal costoEnvio
        +Decimal total
        +EstadoComanda estado
        +agregarLinea(plato, cantidad, nota) LineaComanda
        +calcularTotal() Decimal
        +sellarHora(hora) void
        +sacarCopia(tipo) CopiaComanda
        +cambiarEstado(estado) void
        +anular(motivo) void
    }

    class LineaComanda {
        +Int cantidad
        +String descripcionPlato
        +Decimal precioUnitario
        +String notaAlMargen
        +subtotal() Decimal
    }

    class PagoContraEntrega {
        +Decimal montoACobrar
        +Decimal pagaCon
        +Boolean requiereCambio
        +Decimal montoCobrado
        +calcularCambio() Decimal
        +registrarCobro(monto) void
    }

    class CopiaComanda {
        +TipoCopia tipo
        +String destinatario
        +Time entregadaA
    }

    class TalonarioComandas {
        +Int serie
        +Int numeroInicial
        +Int numeroFinal
        +Int ultimoUsado
        +siguienteNumero() Int
        +estaAgotado() Boolean
    }

    class MesaLogistica {
        +String ubicacion
        +Int comandasPendientes
        +recibir(comanda) void
        +tomarSiguiente() Comanda
    }

    class CanalContacto {
        <<enumeration>>
        TELEFONO_FIJO
        PUNTO_FISICO
    }

    class TipoCopia {
        <<enumeration>>
        ORIGINAL
        COPIA_RESTAURANTE
        COPIA_ARCHIVO
    }

    class EstadoComanda {
        <<enumeration>>
        RECIBIDA
        AVISADA_A_COCINA
        EN_PREPARACION
        LISTA_PARA_RECOGER
        EN_REPARTO
        ENTREGADA
        NO_ENTREGADA
        LIQUIDADA
        ANULADA
    }

    %% ---- Clases externas referenciadas (definidas en otros diagramas) ----
    class Cliente
    class Direccion
    class OperadorTelefonico
    class PromotorCampo
    class PuntoContacto
    class CatalogoMaestro
    class RestauranteAliado
    class Plato

    %% ================== RELACIONES ==================
    Cliente "1" --> "0..*" ContactoCliente : inicia
    OperadorTelefonico "0..1" --> "0..*" ContactoCliente : atiende por telefono
    PromotorCampo "0..1" --> "0..*" ContactoCliente : atiende en persona
    ContactoCliente "0..*" --> "0..1" PuntoContacto : ocurre en
    ContactoCliente ..> CatalogoMaestro : se lee el menu de
    ContactoCliente "1" --> "0..1" Comanda : origina

    Comanda "1" *-- "1..*" LineaComanda : contiene
    LineaComanda "0..*" --> "1" Plato : corresponde a
    Comanda "0..*" --> "1" RestauranteAliado : se pide a
    Comanda "0..*" --> "1" Direccion : se entrega en
    Comanda "1" *-- "1" PagoContraEntrega : se cobra con
    Comanda "1" *-- "1..3" CopiaComanda : se copia en

    TalonarioComandas "1" --> "0..*" Comanda : numera
    MesaLogistica "1" o-- "0..*" Comanda : recibe en mano

    ContactoCliente "0..*" --> "1" CanalContacto : llega por
    CopiaComanda "0..*" --> "1" TipoCopia : es
    Comanda "0..*" --> "1" EstadoComanda : esta en
